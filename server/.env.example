# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/leatch

# --- Auth ---
# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES=30d

# Comma separated list of extra allowed CORS origins (extension origins are always allowed).
CORS_ORIGINS=

# --- AI (optional) ---
# Without a key the extension falls back to its built-in offline dictionary.
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default. For much lower cost try claude-haiku-5-5.
AI_MODEL=claude-opus-5-5
# low | medium | high  (low keeps token spend down; this task does not need deep reasoning)
AI_EFFORT=low
# Max number of *uncached* AI chunk analyses per user per day (cache hits are free).
AI_DAILY_CHUNK_LIMIT=300
