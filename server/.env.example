# ─────────────────────────────── Server ───────────────────────────────
NODE_ENV=development            # production enables strict checks, JSON logs, HSTS
PORT=4000
LOG_LEVEL=info                  # error | warn | info | debug
# LOG_FORMAT=json               # json (default in production) | pretty

# ────────────────────────────── Database ──────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Any of these work:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/          (credentials inline)
#   mongodb+srv://USER:<db_password>@cluster0.xxxx.mongodb.net/     (+ MONGODB_PASSWORD below)
#   mongodb+srv://cluster0.xxxx.mongodb.net/                        (+ MONGODB_USERNAME/PASSWORD)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=leatch
MONGODB_MAX_POOL_SIZE=50        # connections per process (Atlas tiers cap total connections)
MONGODB_MIN_POOL_SIZE=2
MONGODB_AUTO_INDEX=true         # set false in large production DBs and run `npm run db:indexes` on deploy
MONGODB_CONNECT_RETRIES=10      # start-up retries with exponential backoff
MONGODB_COMPRESSORS=            # optional wire compression, e.g. zlib (costs CPU on small queries)

# ──────────────────────────────── Auth ────────────────────────────────
# Long random string; production requires 48+ chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES=30d
LOGIN_MAX_FAILURES=5            # consecutive wrong passwords before a temporary lock
LOGIN_LOCK_MINUTES=15
PASSWORD_HASH_CONCURRENCY=4     # parallel scrypt hashes per process (CPU/memory guard)

# ─────────────────────────── HTTP / network ───────────────────────────
# Number of reverse proxies in front of the API (nginx = 1; cloud LB + nginx = 2).
# Required for correct client IPs in rate limiting. Never set higher than reality.
TRUST_PROXY=0
CORS_ORIGINS=                   # extra web origins, comma separated
ALLOWED_EXTENSION_IDS=          # lock CORS to your published extension ID(s) in production
COMPRESSION=true                # gzip large JSON responses (disable if your proxy compresses)
REQUEST_TIMEOUT_MS=30000
AI_REQUEST_TIMEOUT_MS=150000
SHUTDOWN_TIMEOUT_MS=25000
WEB_CONCURRENCY=0               # `npm run start:cluster` workers (0 = one per CPU core)

# ──────────────────── Rate limiting & load shedding ───────────────────
REDIS_URL=                      # e.g. redis://localhost:6379 — shares limits across processes/instances
RATE_LIMIT_GLOBAL_PER_MIN=300   # per client IP, all API routes
RATE_LIMIT_USER_PER_MIN=600     # per logged-in account
RATE_LIMIT_AUTH_PER_15_MIN=20   # failed login/register attempts per IP
RATE_LIMIT_AI_PER_MIN=30        # AI analysis calls per account
RATE_LIMIT_WRITE_PER_MIN=60     # saves/deletes per account
LOAD_SHED_MAX_LAG_MS=300        # answer 503 while event-loop lag exceeds this (0 = off)

# ───────────────────────────── AI (optional) ──────────────────────────
# Without a key the extension falls back to its built-in offline dictionary.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5        # claude-haiku-5-5 is much cheaper for this task
AI_EFFORT=low                   # low | medium | high
AI_DAILY_CHUNK_LIMIT=300        # uncached analyses per user per day (cache hits are free)
AI_MAX_CONCURRENT_REQUESTS=16   # simultaneous Claude calls per process
